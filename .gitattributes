# Автоматически нормализовать окончания строк
* text=auto

# Python файлы
*.py text eol=lf

# JS/JSX/TS/TSX
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf

# Прочее
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Бинарные файлы
*.png binary
*.ico binary
*.exe binary
*.dll binary
